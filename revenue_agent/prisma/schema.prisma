// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model Material {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  currentCost Float
  marketCost  Float
  supplier    String
  orders      Order[]
}

model Order {
  id         String   @id
  client     String
  margin     String
  materialId Int
  material   Material @relation(fields: [materialId], references: [id])
}

model Shipment {
  id              Int            @id @default(autoincrement())
  material        String
  qty             String
  supplier        String
  currentNode     String
  eta             String
  status          String
  gemmaAnnotation String
  steps           ShipmentStep[]
}

model ShipmentStep {
  id         Int      @id @default(autoincrement())
  shipmentId Int
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  name       String
  status     String
  sequence   Int
}

model MarketSignal {
  id        Int    @id @default(autoincrement())
  title     String
  source    String
  date      String
  relevance String
  tag       String
  desc      String
  url       String
}

model PricingRecommendation {
  id         String   @id
  trigger    String
  action     String
  confidence String
  reasoning  Json     // list of strings representing the reasoning trail
  accepted   Boolean  @default(false)
  rejected   Boolean  @default(false)
  expanded   Boolean  @default(false)
  sourceName String?
  sourceDate String?
  sourceUrl  String?
}

model StructuralRisk {
  id            Int    @id @default(autoincrement())
  trend         String
  status        String
  title         String
  description   String
  gemmaAdvisory String
}

model IndustryNews {
  id       Int    @id @default(autoincrement())
  title    String
  source   String
  date     String
  summary  String
  category String
  image    String
  url      String
}

model InventoryItem {
  id           Int      @id @default(autoincrement())
  name         String
  category     String   // "Raw Material" | "Tooling" | "WIP" | "Finished"
  sku          String   @unique
  quantity     Int
  unit         String   // "pcs" | "kg" | "meters"
  location     String   // "Rack A-1", "Bin 3", etc.
  minThreshold Int     // for reorder alerts
  status       String   // "In Stock" | "Low Stock" | "Out of Stock"
  image        String   // public path, e.g. "/inventory/aluminum-blocks.png"
  lastUpdated  DateTime @default(now())
}

model OutreachLog {
  id        Int      @id @default(autoincrement())
  client    String
  channel   String
  tone      String
  content   String
  sentAt    DateTime @default(now())
}

model Supplier {
  id                Int      @id @default(autoincrement())
  name              String   @unique
  materials         String
  avgLeadTime       String
  estimatedQuote    String
  reliabilityRating String
  contactChannel    String
  whatsappJid       String?  @default("")
  sourceUrl         String
}

model WorkflowInstance {
  id              String                  @id @default(cuid())
  operationId     String
  goalId          String?
  workflowType    String
  title           String
  assignedWorker  String
  status          String                  // "Created" | "Planning" | "Pending_Approval" | "Executing" | "Verifying" | "Completed" | "Failed" | "Cancelled"
  currentStep     Int                     @default(0)
  businessImpact  String?
  expectedOutcome String?
  contextSnapshot Json?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  steps           WorkflowStepExecution[]
  auditLogs       WorkflowAuditLog[]
  tasks           TaskInstance[]
}

model WorkflowStepExecution {
  id                String           @id @default(cuid())
  workflowId        String
  workflow          WorkflowInstance @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  sequence          Int
  name              String
  toolId            String
  inputParameters   Json
  executionMode     String           // "Autonomous" | "Approval_Required" | "Manual"
  status            String           // "Pending" | "Approved" | "Executing" | "Completed" | "Failed"
  verificationState String?
  outputResult      Json?
  executedAt        DateTime?
}

model WorkflowAuditLog {
  id            String           @id @default(cuid())
  workflowId    String
  workflow      WorkflowInstance @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepId        String?
  timestamp     DateTime         @default(now())
  actor         String           // "ExecutiveCTO" | "ProcurementWorker" | "FactoryOwner"
  action        String
  previousState String?
  newState      String?
  payload       Json?
}

model BusinessGoal {
  id            String   @id @default(cuid())
  name          String
  category      String   // "MarginProtection" | "InventoryOptimization" | "ARReduction" | "RevenueGrowth"
  targetMetric  String
  currentMetric String
  status        String   // "OnTrack" | "AtRisk" | "Achieved"
  updatedAt     DateTime @default(now())
}

model TaskInstance {
  id             String           @id @default(cuid())
  workflowId     String
  workflow       WorkflowInstance @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  title          String
  assignedWorker String
  priority       String           // "Low" | "Medium" | "High" | "Critical"
  status         String           // "Pending" | "InProgress" | "Blocked" | "Completed"
  businessImpact String?
  deadline       DateTime?
  createdAt      DateTime         @default(now())
}

model KnowledgeItem {
  id          String   @id @default(cuid())
  category    String   // "SOP" | "PricingRule" | "SupplierPolicy" | "ManufacturingProcedure"
  title       String
  content     String
  tags        String   // comma-separated
  lastUpdated DateTime @default(now())
}

model OperationState {
  id             String   @id @default(cuid())
  operationId    String   @unique // "procurement", "pricing", "revenue", etc.
  name           String
  status         String   // "Optimal" | "Attention_Required" | "Critical"
  activeCount    Int      @default(0)
  completedCount Int      @default(0)
  kpis           Json
  lastUpdated    DateTime @default(now())
}

